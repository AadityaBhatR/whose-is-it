{
  "name": "whose-is-it",
  "productName": "Whose Is It",
  "version": "1.1.0",
  "description": "Party game: upload obfuscated photos, guess whose is whose.",
  "author": "Aaditya Bhat",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "server": "node --import tsx server/index.ts",
    "playtest": "node scripts/playtest.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "github:setup": "node scripts/github.mjs setup",
    "github:server": "node scripts/github.mjs server",
    "github:release": "node scripts/github.mjs release"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@types/node": "20.19.9",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "2.3.0",
    "lucide-react": "1.48.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io-client": "4.8.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "socket.io": "4.8.1"
  }
}
